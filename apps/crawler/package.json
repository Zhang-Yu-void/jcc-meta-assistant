{
  "name": "@jcc/crawler",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "jcc-crawl": "./src/cli.ts"
  },
  "scripts": {
    "crawl": "tsx src/cli.ts",
    "xhs:login": "tsx src/xhs-login.ts",
    "xhs:login-sync": "tsx src/xhs-login-sync.ts",
    "xhs:check": "tsx src/xhs-check.ts",
    "xhs:crawl": "XHS_MODE=playwright tsx src/cli.ts --skip taptap,nga",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jcc/meta-schema": "workspace:*",
    "@jcc/screen-match": "workspace:*",
    "cheerio": "^1.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
